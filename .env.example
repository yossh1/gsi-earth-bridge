# Public hostname or IP reachable by the Windows Google Earth Pro PC.
GSI_OVERLAY_PUBLIC_URL=http://192.0.2.10:8765

# Host port and bind address. Use 127.0.0.1 when access is through a local
# HTTPS reverse proxy; otherwise restrict access with the host firewall.
GSI_OVERLAY_PORT=8765
GSI_OVERLAY_BIND_ADDRESS=0.0.0.0
