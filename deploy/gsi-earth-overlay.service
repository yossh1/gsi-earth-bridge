[Unit]
Description=GSI map overlay for Google Earth Pro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gsi-earth-overlay
Group=gsi-earth-overlay
WorkingDirectory=/opt/gsi-earth-overlay
EnvironmentFile=/etc/default/gsi-earth-overlay
ExecStart=/usr/bin/python3 /opt/gsi-earth-overlay/app.py --host ${GSI_OVERLAY_HOST} --port ${GSI_OVERLAY_PORT} --public-url ${GSI_OVERLAY_PUBLIC_URL} --no-browser
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
